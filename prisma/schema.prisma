// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your API?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id    Int     @id @default(autoincrement())
  username  String @unique
  password  String
  /// Public display name shown in the dashboard (login username stays unchanged).
  displayName String?
  /// Avatar image URL or data URL (size-capped client-side).
  avatarUrl String?
  /// Dashboard accent hex color (e.g. #c3d3e6). Overrides --anya-blush in the shell.
  dashboardAccent String?
  /// Set when first-login onboarding is completed or skipped.
  onboardingCompletedAt DateTime?
  isAdmin   Boolean @default(false)
  staffRole String?
  accountStatus String @default("active")
  /// Set when accountStatus is "investigate": "flagged" | "under_investigation"
  investigationStatus String?
  investigationFlaggedAt DateTime?
  investigationFlaggedById Int?
  investigationFlaggedByUsername String?
  investigationNote String?
  createdAt DateTime @default(now())
  subscripted Boolean @default(false)
  licenseId Int?      @unique
  license License?
  plan String @default("free")
  balance Float @default(0)
  billingInterval String @default("monthly")
  /// When the current paid plan period ends (access drops to free after this unless renewed).
  planEndsAt DateTime?
  /// If true, do not expect renewal — access remains until planEndsAt, then free.
  cancelAtPeriodEnd Boolean @default(false)
  apiAccess Boolean @default(false)
  apiKey String?
  recoveryEmail String?
  freeTier Boolean @default(true)
  professionalTier Boolean @default(false)
  investigatorTier Boolean @default(false)
  enterpriseTier Boolean @default(false)
  stripeCustomerId String?
  searches  SearchHistory[]
  cases     Case[]
  payments  Payment[]
  tickets   SupportTicket[]
  ticketMessages SupportTicketMessage[]
  safetyFlags SafetyFlag[]
  osintEventLogs OsintEventLog[]
}

/// Unified safety / investigation case for auto underage-risk flags and helper Investigate.
model SafetyFlag {
  id                   Int      @id @default(autoincrement())
  publicId             String   @unique @default(cuid())
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchHistoryId      Int?
  searchHistory        SearchHistory? @relation(fields: [searchHistoryId], references: [id], onDelete: SetNull)
  /// auto | helper | admin
  source               String
  /// underage_search | helper_investigate | admin_investigate | other
  reasonCode           String   @default("underage_search")
  /// underage_risk | manual_review | other
  category             String   @default("underage_risk")
  /// open | reviewing | resolved
  status               String   @default("open")
  /// Query that triggered the flag (staff-only review)
  queryPreview         String
  moduleSlug           String?
  searchType           String?
  /// JSON array of matched rule ids
  matchedRules         String   @default("[]")
  reason               String   @default("")
  flaggedById          Int?
  flaggedByUsername    String?
  assignedHelperId     Int?
  assignedHelperUsername String?
  /// Latest message from helper/admin — delivered to flagged user (not staff inbox)
  helperMessage        String?
  /// JSON array of { at, byId, byUsername, message } — staff-visible history
  helperMessageHistory String   @default("[]")
  notifiedAt           DateTime?
  /// When the flagged user acknowledged the on-screen notice
  acknowledgedAt       DateTime?
  reviewedById         Int?
  reviewedByUsername   String?
  reviewNote           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  resolvedAt           DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([source, status])
  @@index([userId, acknowledgedAt, notifiedAt])
}

/// Staff-only OSINT action / error audit trail (never shown on user search panels).
model OsintEventLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. search.us-identity, search.email-presence, route.error
  action       String
  /// ok | error | partial | rate_limited | info
  status       String
  message      String?
  queryPreview String?
  moduleSlug   String?
  /// JSON blob for extra context (source ids, stack-ish details)
  metaJson     String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String   @default("general")
  status    String   @default("open")
  priority  String   @default("normal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SupportTicketMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportTicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  isStaff    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Payment {
  id                   Int      @id @default(autoincrement())
  userId               Int
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount               Float
  currency             String   @default("USD")
  type                 String
  plan                 String?
  interval             String?
  status               String   @default("completed")
  description          String   @default("")
  stripeSessionId      String?  @unique
  stripePaymentIntentId String?
  stripeSubscriptionId String?
  createdAt            DateTime @default(now())
}

model License {
  id       Int      @id @default(autoincrement())
  key      String   @unique @default(cuid())
  redeemed Boolean  @default(false)
  userId   Int?     @unique
  user     User?    @relation(fields: [userId], references: [id])
  isProfessional Boolean? @default(false)
  isInvestigator Boolean? @default(false)
  isEnterprise Boolean? @default(false)
  createdAt DateTime @default(now())
  durationInDays Int @default(30)
  daysRemaining Int @default(30)
}

model SearchHistory {
  id         Int          @id @default(autoincrement())
  query      String
  searchType String       @default("search")
  resultData String       @default("")
  createdAt  DateTime     @default(now())
  userId     Int
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caseLinks  CaseSearch[]
  safetyFlags SafetyFlag[]
}

/// Short-lived full OSINT payloads for teaser/paygate unlock (inspect-safe).
model SearchResultVault {
  id               String    @id
  claimTokenHash   String
  moduleSlug       String
  queryHash        String    @default("")
  queryPreview     String    @default("")
  payload          String
  metaJson         String    @default("{}")
  userId           Int?
  ipHash           String?
  unlockMode       String    @default("teaser")
  planRequired     String?
  creditCost       Float     @default(1)
  allowCreditUnlock Boolean  @default(true)
  expiresAt        DateTime
  claimedAt        DateTime?
  claimedByUserId  Int?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
  @@index([claimTokenHash])
}

model Case {
  id          Int          @id @default(autoincrement())
  title       String
  subjectName String
  email       String?
  phone       String?
  username    String?
  location    String?
  notes       String       @default("")
  intelData   String       @default("")
  status      String       @default("active")
  userId      Int
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  searches    CaseSearch[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model CaseSearch {
  id              Int           @id @default(autoincrement())
  caseId          Int
  case            Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  searchHistoryId Int
  searchHistory   SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([caseId, searchHistoryId])
}

/// Daily marketing-site visit counter (cookie-deduped ~1 count per browser/day).
/// Historical days before collection started show as 0 on the admin Activity graph.
model SiteVisitDaily {
  id        Int      @id @default(autoincrement())
  /// YYYY-MM-DD (UTC day key, matches workspace overview trafficByDay)
  date      String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Admin-managed values stripped from OSINT / breach / search responses.
/// Matching is exact against normalizeBlacklistValue (trim + lowercase).
model DataBlacklist {
  id              Int      @id @default(autoincrement())
  /// Normalized value used for lookups (unique).
  value           String   @unique
  /// Original trimmed value as entered by the admin (display).
  displayValue    String
  note            String?
  createdById     Int?
  createdByUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}
