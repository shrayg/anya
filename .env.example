# Anya.Int environment variables (copy to .env.local)

# Session signing — use a long random string in production (required)
JWT_SECRET=change-me

# Cookies: set true only when the site runs on HTTPS
COOKIE_SECURE=false

# Optional public site URL (used for secure-cookie detection + Stripe redirects)
# APP_URL=https://anyaint.com
# NEXT_PUBLIC_APP_URL=https://anyaint.com

# Intelligence provider keys (server-side only — never shown in the UI)
OSINTCAT_API_KEY=
GODSEYE_API_KEY=
GODSEYE_EXPORT_API_KEY=
# Optional: set GODSEYE_ENABLED=false to disable GodsEye without removing keys

# Discord webhook for support ticket notifications (server-side only)
# Example: https://discord.com/api/webhooks/123/abc
DISCORD_SUPPORT_WEBHOOK_URL=

# Stripe (server-side secret; publishable key is safe for client use)
# Use sk_test_ / pk_test_ for sandbox, sk_live_ / pk_live_ for production
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks
# Endpoint URL: https://your-domain/api/billing/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
