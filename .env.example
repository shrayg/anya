# Enkidu.Int environment variables (copy to .env.local)

# Session signing
JWT_SECRET=change-me

# Cookies: set true only when the site runs on HTTPS
COOKIE_SECURE=false

# Optional public site URL (used for secure-cookie detection)
# APP_URL=http://45.156.87.33:3000

# Intelligence provider keys (server-side only — never shown in the UI)
OSINTCAT_API_KEY=
GODSEYE_API_KEY=
GODSEYE_EXPORT_API_KEY=
# Optional: set GODSEYE_ENABLED=false to disable GodsEye without removing keys
