# Anya.Int environment variables (copy to .env.local)

# Session signing — use a long random string in production (required)
JWT_SECRET=change-me

# Cookies: set true only when the site runs on HTTPS
COOKIE_SECURE=false

# Optional public site URL (used for secure-cookie detection + payment redirects)
# APP_URL=https://anyaint.com
# NEXT_PUBLIC_APP_URL=https://anyaint.com

# Intelligence provider keys (server-side only — never shown in the UI)
OSINTCAT_API_KEY=
# Instagram follower/following export (session cookies from a logged-in IG account)
# INSTAGRAM_SESSION_ID=
# INSTAGRAM_CSRF_TOKEN=
# Optional stability cookies
# INSTAGRAM_DS_USER_ID=
# INSTAGRAM_MID=
# INSTAGRAM_IG_DID=
# INSTAGRAM_DATR=
GODSEYE_API_KEY=
GODSEYE_EXPORT_API_KEY=
CSINT_API_KEY=
# Optional: set GODSEYE_ENABLED=false to disable GodsEye without removing keys
# GODSEYE_ENABLED=false
# Optional: set CSINT_ENABLED=false to disable csint.pro without removing keys
# CSINT_ENABLED=false

# Free BreachVIP breach index (no API key). On by default.
# Optional: set BREACH_VIP_ENABLED=false to disable
# BREACH_VIP_ENABLED=false

# US public records (server-side only)
# Free account token from https://www.courtlistener.com/help/api/rest/
COURTLISTENER_TOKEN=
# api.data.gov key for OpenFEC (falls back to DEMO_KEY if unset)
OPENFEC_API_KEY=
# OpenSanctions API key from https://www.opensanctions.org/docs/api/
OPENSANCTIONS_API_KEY=
# SAM.gov public API key from https://sam.gov/content/entity-information
SAM_GOV_API_KEY=

# Discord webhook for support ticket notifications (server-side only)
# Example: https://discord.com/api/webhooks/123/abc
DISCORD_SUPPORT_WEBHOOK_URL=

# Discord webhook for successful payment notifications (plans, credits, API)
# Falls back to DISCORD_SUPPORT_WEBHOOK_URL if unset
DISCORD_PAYMENTS_WEBHOOK_URL=

# Square payments (Production credentials from developer.squareup.com)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
# Webhook notification URL must match exactly what is configured in Square
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://anyaint.com/api/billing/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
