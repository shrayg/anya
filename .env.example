# Anya.Int environment variables (copy to .env.local)

# Session signing ? use a long random string in production (required)
JWT_SECRET=change-me

# Cookies: set true only when the site runs on HTTPS
COOKIE_SECURE=false

# Cloudflare Turnstile (login/register bot protection)
# Create a widget at https://dash.cloudflare.com ? Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional Cloudflare API (dashboard automation ? TLS min version, etc.)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Optional public site URL (used for secure-cookie detection + payment redirects)
# APP_URL=https://anyaint.com
# NEXT_PUBLIC_APP_URL=https://anyaint.com

# Intelligence provider keys (server-side only ? never shown in the UI)
OSINTCAT_API_KEY=
# Instagram follower/following export (session cookies from a logged-in IG account)
# Prefer storing these on the VPS in /var/www/anya-secrets/instagram.env so deploys
# never wipe them. Admin refresh: POST /api/admin/instagram-session
# INSTAGRAM_SESSION_ID=
# INSTAGRAM_CSRF_TOKEN=
# Optional stability cookies
# INSTAGRAM_DS_USER_ID=
# INSTAGRAM_MID=
# INSTAGRAM_IG_DID=
# INSTAGRAM_DATR=
# Auto re-login when cookies die (stored ONLY in secrets file on the VPS ? never commit)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
# Optional authenticator seed if the account has 2FA TOTP enabled
# INSTAGRAM_TOTP_SECRET=
# Optional residential proxy URL to reduce VPS/datacenter checkpoints
# INSTAGRAM_PROXY_URL=http://user:pass@host:port
# Shared OSINT residential proxy (Email Profiles / Hinge Live / hard probes).
# Falls back to INSTAGRAM_PROXY_URL when unset.
# OSINT_RESIDENTIAL_PROXY_URL=http://user:pass@host:port
# Optional extra logged-in accounts for rotation (spreads rate limits). JSON array.
# Each entry needs at least sessionId; csrfToken/dsUserId/mid/igDid/datr/proxyUrl optional.
# INSTAGRAM_ACCOUNTS=[{"label":"acct2","sessionId":"...","csrfToken":"...","dsUserId":"...","proxyUrl":"http://user:pass@host:port"}]
# Optional override for the durable secrets file path
# ANYA_INSTAGRAM_SECRETS_PATH=/var/www/anya-secrets/instagram.env
# Shared secret for PM2 cron ? POST /api/internal/instagram-keepalive
# INSTAGRAM_CRON_SECRET=
GODSEYE_API_KEY=
GODSEYE_EXPORT_API_KEY=
CSINT_API_KEY=
# Optional: set GODSEYE_ENABLED=false to disable GodsEye without removing keys
# GODSEYE_ENABLED=false
# Optional: set CSINT_ENABLED=false to disable csint.pro without removing keys
# CSINT_ENABLED=false
# BreachHub.org unified OSINT aggregator (server-side only)
BREACHHUB_API_KEY=
# Optional: set BREACHHUB_ENABLED=false to disable BreachHub without removing the key
# BREACHHUB_ENABLED=false
# Seekria ? optional direct key (defaults to BreachHub /api/seekria/* when unset)
# SEEKRIA_API_KEY=
# SEEKRIA_BASE_URL=https://breachhub.org
# SEEKRIA_ENABLED=false
# SeekNow (See-Know) ? optional direct key (defaults to BreachHub /api/seeknow/* when unset)
# SEEKNOW_API_KEY=
# SEEKNOW_BASE_URL=https://breachhub.org
# SEEKNOW_ENABLED=false
# NotaliveX (country/platform DBs + AR Renaper) proxies via BreachHub ? same key
# Optional: set NOTALIVEX_ENABLED=false to disable NotaliveX without removing BREACHHUB_API_KEY
# NOTALIVEX_ENABLED=false
# Room101 (Reddit OSINT) ? optional direct key (defaults to BreachHub /api/room101/* when unset)
# ROOM101_API_KEY=
# ROOM101_BASE_URL=https://breachhub.org
# ROOM101_ENABLED=false
# Wentyn stealer logs ? optional direct key (defaults to BreachHub /api/wentyn when unset)
# WENTYN_API_KEY=
# WENTYN_BASE_URL=https://breachhub.org
# WENTYN_ENABLED=false
# Telegram OSINT - username / id / phone (GET /api/telegram/{username|id|phone})
# Optional direct key (defaults to BreachHub /api/telegram/* when unset).
# TELEGRAM_API_KEY=
# TELEGRAM_BASE_URL=https://breachhub.org
# TELEGRAM_ENABLED=false
# Snapchat OSINT - username / profile lookup (GET /api/snapchat)
# Optional direct key (defaults to BreachHub /api/snapchat when unset).
# SNAPCHAT_API_KEY=
# SNAPCHAT_BASE_URL=https://breachhub.org
# SNAPCHAT_ENABLED=false
# Checko (Russian EGRUL company registry) — optional direct key (defaults to BreachHub /api/checko when unset)
# Native API: CHECKO_BASE_URL defaults to https://api.checko.ru when CHECKO_API_KEY is set
# CHECKO_API_KEY=
# CHECKO_BASE_URL=https://breachhub.org
# CHECKO_ENABLED=false
# Melissa contact enrichment â€” optional direct key (defaults to BreachHub /api/melissa, then CSINT)
# MELISSA_API_KEY=
# MELISSA_BASE_URL=https://breachhub.org
# MELISSA_ENABLED=false
# Reconly Discord/username/email/FiveM â€” optional direct key (defaults to BreachHub /api/reconly when unset)
# RECONLY_API_KEY=
# RECONLY_BASE_URL=https://breachhub.org
# RECONLY_ENABLED=false
# NBRS Roblox - optional direct key (defaults to BreachHub /api/nbrs/roblox when unset)
# NBRS_API_KEY=
# NBRS_BASE_URL=https://breachhub.org
# NBRS_ENABLED=false
# Memory.lol (X/Twitter username history) - optional direct key (defaults to BreachHub /api/memory)
# MEMORY_API_KEY=
# MEMORY_BASE_URL=https://breachhub.org
# MEMORY_ENABLED=false
# LeakSight breach/leak lookup ? optional direct key (defaults to BreachHub /api/leaksight when unset)
# LEAKSIGHT_API_KEY=
# LEAKSIGHT_BASE_URL=https://breachhub.org
# LEAKSIGHT_ENABLED=false
# Inf0sec multi-module OSINT ? optional direct key (defaults to BreachHub /api/inf0sec)
# INFOSEC_* aliases accepted. For native vendor: INF0SEC_BASE_URL=https://inf0sec.top
# INF0SEC_API_KEY=
# INF0SEC_BASE_URL=https://breachhub.org
# INF0SEC_ENABLED=false
# VIN lookup â€” NHTSA decode is always on; optional specialty key for index enrichment
# (defaults to BreachHub GET /api/vin / specialty when unset). Set VIN_ENABLED=false to disable.
# VIN_API_KEY=
# VIN_BASE_URL=https://breachhub.org
# VIN_ENABLED=false
# PropertyRadar (property / people / skip-trace) — optional direct key
# Defaults to BreachHub GET /api/propertyradar/* when unset.
# Set PROPERTYRADAR_BASE_URL=https://api.propertyradar.com for native REST (Bearer token).
# PROPERTY_RADAR_* aliases accepted. Site paths stay GET.
# PROPERTYRADAR_API_KEY=
# PROPERTYRADAR_BASE_URL=https://breachhub.org
# PROPERTYRADAR_ENABLED=false
# IPInfo geolocation / ASN â€” optional direct token (defaults to BreachHub /api/ipinfo when unset)
# IPINFO_TOKEN=
# IPINFO_API_KEY=
# IPINFO_BASE_URL=https://ipinfo.io
# IPINFO_ENABLED=false
# GitHub OSINT ? profile lookup by username or email (GET /api/github)
# Optional direct vendor key (defaults to BreachHub /api/github when unset).
# GITHUB_API_KEY=
# GITHUB_BASE_URL=https://breachhub.org
# Optional native GitHub.com PAT fallback when BreachHub / GITHUB_API_KEY are unset.
# GITHUB_TOKEN=
# GITHUB_API_TOKEN=
# GITHUB_ENABLED=false
# Direct Snusbase API (optional ? BreachHub/CSINT already mirror Snusbase when keyed)
SNUSBASE_API_KEY=
# Optional: set SNUSBASE_ENABLED=false to disable direct Snusbase without removing the key
# SNUSBASE_ENABLED=false
# Optional: disable entire Crypto Intel suite (address/tx/risk/flow + roadmap tiles)
# CRYPTO_INTEL_ENABLED=0
# NEXT_PUBLIC_CRYPTO_INTEL=0

# Tinder Live ? operator session for filtered recommendation search (NOT username OSINT)
# Package: tinder-api-ts (https://github.com/Miguelo981/tinder-api) ? audited for Anya.
# 1) Log into Tinder Web in a browser you control.
# 2) DevTools ? Application ? IndexedDB ? keyval-store ? persist::mfa ? authToken
#    (or run the console snippet from the tinder-api README).
# 3) localStorage key TinderWeb/uuid ? persistent device id.
# 4) Gold/Platinum recommended for interest / bio / photo preference filters.
# 5) Store ONLY on the server (VPS secrets), never commit tokens.
# TINDER_X_AUTH_TOKEN=
# TINDER_DEVICE_ID=
# Optional locale (default en-US)
# TINDER_LOCALE=en-US
# Force-disable even if credentials exist:
# TINDER_LIVE_ENABLED=0
# NEXT_PUBLIC_TINDER_LIVE=0

# Hinge Live ? operator session for filtered recommendation search (NOT username OSINT)
# Capture from Charles MITM on a company device (prod-api.hingeaws.net):
#   Authorization (Bearer ?), X-Device-Id, X-Install-Id, optional X-Session-Id / playerId.
# Flow: PATCH location + prefs ? POST /rec/v2 ? hydrate /user/v3/public + /content/v2/public.
# Does NOT expose like/rate/chat. Session feed sample only ? not a city-wide user DB.
# Requests use OSINT_RESIDENTIAL_PROXY_URL / INSTAGRAM_PROXY_URL by default (datacenter IPs fail).
# Store ONLY on the server (VPS secrets), never commit tokens. Rotate if .chlz was shared.
# HINGE_AUTHORIZATION=Bearer ?
# HINGE_DEVICE_ID=
# HINGE_INSTALL_ID=
# Optional:
# HINGE_PLAYER_ID=
# HINGE_SESSION_ID=
# HINGE_APP_VERSION=9.130.0
# HINGE_BUILD_NUMBER=11692
# HINGE_LIVE_REQUIRE_PROXY=1
# Force-disable even if credentials exist:
# HINGE_LIVE_ENABLED=0
# NEXT_PUBLIC_HINGE_LIVE=0

# CordCat Discord profile enrichment (optional ? https://cord.cat/docs/)
# Prefer for animated avatar/banner and richer Discord-native profile fields.
# Get a free key from cord.cat Dashboard. Falls back to other profile sources if unset.
CORDCAT_API_KEY=

# Discord specialty routes (/api/discord/user|history|export|snowflake)
# Proxied via BREACHHUB_API_KEY. ID decode always works locally.
# Optional: set DISCORD_API_ENABLED=false to disable these specialty routes.
# DISCORD_API_ENABLED=false

# US public records (server-side only)
# Free account token from https://www.courtlistener.com/help/api/rest/
COURTLISTENER_TOKEN=
# api.data.gov key for OpenFEC (falls back to DEMO_KEY if unset)
OPENFEC_API_KEY=
# OpenSanctions API key from https://www.opensanctions.org/docs/api/
OPENSANCTIONS_API_KEY=
# SAM.gov public API key from https://sam.gov/content/entity-information
SAM_GOV_API_KEY=
# USPTO Open Data Portal / PTAB key from https://account.uspto.gov/api-manager/
USPTO_API_KEY=

# Discord webhook for support ticket notifications (server-side only)
# Example: https://discord.com/api/webhooks/123/abc
DISCORD_SUPPORT_WEBHOOK_URL=

# Discord webhook for successful payment notifications (plans, credits, API)
# Falls back to DISCORD_SUPPORT_WEBHOOK_URL if unset
DISCORD_PAYMENTS_WEBHOOK_URL=

# Square payments (Production credentials from developer.squareup.com)
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=production
# Webhook notification URL must match exactly what is configured in Square
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://anyaint.com/api/billing/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=

# OxaPay crypto invoices (merchant API key from oxapay.com)
OXAPAY_MERCHANT_API_KEY=
# Set true only for OxaPay sandbox test invoices
OXAPAY_SANDBOX=false
# Callback: https://anyaint.com/api/billing/oxapay/webhook

# SEON fraud intelligence (official api.seon.io or compatible gateway)
SEON_API_KEY=
SEON_BASE_URL=https://api.seon.io/SeonRestService/fraud-api/v2.0
SEON_ENABLED=true
